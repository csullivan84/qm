{
  "name": "@yc-software/qm",
  "version": "0.1.4",
  "private": true,
  "license": "MIT",
  "description": "Control-plane CLI for portable QM deployments on Docker, Fly, and AWS.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csullivan84/qm.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/csullivan84/qm/tree/main/cli#readme",
  "bugs": "https://github.com/csullivan84/qm/issues",
  "bin": {
    "qm": "dist/bin/qm.js"
  },
  "exports": {
    "./contract": {
      "types": "./dist/src/contract.d.ts",
      "default": "./dist/src/contract.js"
    }
  },
  "engines": {
    "node": ">=26.5.1",
    "npm": ">=12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "files": [
    "dist",
    "templates",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "qm": "node -- bin/qm.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.e2e.test.ts",
    "test:all": "node --test test/*.test.ts test/e2e/*.e2e.test.ts",
    "test:pack": "node --test test/package.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "age-encryption": "0.3.0"
  },
  "bundledDependencies": [
    "age-encryption"
  ]
}
